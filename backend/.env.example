# ─── Server Configuration ───
PORT=5000
NODE_ENV=production

# ─── Database Configurations ───
# PostgreSQL Connection URL (standard port 5432, with pool sizing)
DATABASE_URL="postgresql://postgres:YourSecurePasswordHere!@127.0.0.1:5432/teerclub?connection_limit=25&pool_timeout=15"

# Redis Server Configuration (standard port 6379)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ─── Scraper Engine Optimization Settings ───
SCRAPER_CONCURRENCY=5
SCRAPER_TIMEOUT=30000
PLAYWRIGHT_TIMEOUT=15000
HEADLESS_BROWSER=true

# ─── Gemini API Configuration ───
# API key used by the hybrid scraping engine to parse crawled pages
GEMINI_API_KEY="YourGeminiApiKeyHere"
AI_FALLBACK_THRESHOLD=10
AI_TIMEOUT=30000

# ─── Internal API Keys ───
# Must match NEXT_PUBLIC_API_KEY in frontend & admin panels to secure communication
API_KEY="YourSecureApiKeyHere"
ADMIN_API_KEY="YourSecureApiKeyHere"

# ─── Google Indexing API Credentials ───
# Service account email configured in your Google Search Console
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# Full private key including newlines (\n) encapsulated in double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"
