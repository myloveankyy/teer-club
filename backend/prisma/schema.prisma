generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id               String       @id @default(uuid())
  name             String       @unique
  displayName      String
  description      String?
  location         String?
  startTime        String?
  frTime           String?
  srTime           String?
  trTime           String?
  closeTime        String?
  hasRound3        Boolean      @default(false)
  isEnabled        Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  historySourceUrl String?
  liveSourceUrl    String?
  
  // Live Scraping / Cron Configuration
  isLiveScrapingEnabled Boolean @default(true)
  lastLiveScrapeAt      DateTime?
  lastLiveScrapeStatus  String?   // "SUCCESS", "FAILED", "NO_NEW_DATA"
  
  predictions      Prediction[]
  results          Result[]
  autoCheckLogs    AutoCheckLog[]
}

model Result {
  id          String    @id @default(uuid())
  gameId      String
  date        DateTime
  round1      String?
  round2      String?
  round3      String?
  confidence  String    @default("LOW")
  sourceCount Int       @default(1)
  verified    Boolean   @default(false)
  detectedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, date])
  @@index([gameId])
  @@index([date])
  @@index([verified])
}

model Page {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  url              String   @unique
  type             String   @default("STATIC")
  status           String   @default("ACTIVE")
  source           String   @default("AUTO")
  meta_title       String?
  meta_description String?
  seo_score        Int      @default(0)
  last_audit_at    DateTime?
  audit_results    Json?
  index_status     String   @default("DISCOVERED")
  h1_count         Int?
  h2_count         Int?
  content_length   Int?
  internal_links   Int?
  performance_score Int?
  indexed          Boolean  @default(true)
  views            Int      @default(0)
  likes            Int      @default(0)
  last_updated     DateTime @default(now()) @updatedAt
  createdAt        DateTime @default(now())
  
  // Blog / Programmatic SEO Fields
  content            String?  @db.Text
  authorId           String?
  
  // Advanced Manual Controls
  featured_image     String?
  image_alt          String?
  image_caption      String?
  image_seo_filename String?

  @@index([url])
  @@index([type])
  @@index([status])
  @@index([seo_score])
  @@index([index_status])
}

model Prediction {
  id            String   @id @default(uuid())
  gameId        String
  date          DateTime
  commonNumbers String[]
  house         String
  ending        String
  directNumber  String
  status        String   @default("GENERATED")
  actualResult  String?
  houseMatch    Boolean  @default(false)
  endingMatch   Boolean  @default(false)
  directMatch   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, date])
  @@index([gameId, date])
  @@index([date])
  @@index([gameId])
  @@index([status])
}

model SiteSettings {
  id                String   @id @default("global")
  youtubeUrl        String?
  youtubeEnabled    Boolean  @default(true)
  whatsappUrl       String?
  whatsappEnabled   Boolean  @default(true)
  telegramUrl       String?
  telegramEnabled   Boolean  @default(true)
  bannerText        String?
  bannerVisible     Boolean  @default(false)
  bannerColor       String?  @default("#2563eb")
  resultAwaitedText String?  @default("Result Awaited")
  sundayOffText     String?  @default("Sunday Off")
  primaryColor      String?  @default("#2563eb")
  accentColor       String?  @default("#22c55e")
  backgroundColor   String?  @default("#ffffff")
  textColor         String?  @default("#111827")
  cardStyle         String?  @default("soft")
  borderRadius      String?  @default("lg")
  updatedAt         DateTime @updatedAt
  playLiveEnabled   Boolean  @default(false)
  playLiveUrl       String?
  
  // Master Scraper Controls
  masterScrapeStartTime String?  @default("15:00")
  masterScrapeEndTime   String?  @default("19:00")
  isMasterScrapeActive  Boolean  @default(false)
  
  // Favicon & Branding
  faviconUrl        String?
  appleTouchIconUrl String?

  // Monetization (AdSense)
  isAdsEnabled          Boolean @default(false)
  googleAdsenseClientId String?
  headerAdUnit          String?
  inFeedAdUnit          String?
  stickyFooterAdUnit    String?
}

model DomainSeoSettings {
  id                 String   @id @default("global")
  defaultMetaTitle   String?
  metaDescription    String?
  defaultKeywords    String?
  canonicalUrlRule   String?  @default("AUTO")
  indexEnabled       Boolean  @default(true)
  followEnabled      Boolean  @default(true)
  structuredDataJson String?  @db.Text
  updatedAt          DateTime @updatedAt
}

model NotificationSettings {
  id                 String   @id @default("global")
  a2hsEnabled        Boolean  @default(true)
  pushEnabled        Boolean  @default(false)
  vapidPublicKey     String?
  vapidPrivateKey    String?
  updatedAt          DateTime @updatedAt
}

model PushSubscriber {
  id           String   @id @default(uuid())
  endpoint     String   @unique
  keys         Json
  deviceType   String?
  browser      String?
  os           String?
  isActive     Boolean  @default(true)
  status       String   @default("active")
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  deliveryLogs PushDeliveryLog[]
}

model PushCampaign {
  id             String   @id @default(uuid())
  title          String
  body           String
  url            String?
  audienceSize   Int      @default(0)
  deliveredCount Int      @default(0)
  failedCount    Int      @default(0)
  clickCount     Int      @default(0)
  sentAt         DateTime @default(now())
  logs           PushDeliveryLog[]
}

model PushDeliveryLog {
  id           String   @id @default(uuid())
  campaignId   String
  subscriberId String
  status       String
  deliveredAt  DateTime?
  clicked      Boolean  @default(false)
  clickedAt    DateTime?
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  campaign   PushCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber PushSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
}

model CronLog {
  id         String   @id @default(uuid())
  game       String
  status     String
  round1     String?
  round2     String?
  resultDate String?
  duration   Int
  error      String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([game])
  @@index([status])
  @@index([createdAt])
}

model SeoProfile {
  id        String    @id @default(uuid())
  name      String
  role      String    @default("SEO Expert")
  avatar    String?
  notes     SeoNote[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SeoNote {
  id        String      @id @default(uuid())
  profileId String
  title     String
  content   String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  profile   SeoProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

model AutoCheckLog {
  id              String   @id @default(uuid())
  gameId          String
  dateChecked     DateTime
  status          String   // "VALID" or "INVALID"
  reason          String?
  sourceUrl       String
  scrapedDate     String?
  scrapedResult   Json?
  layerResults    Json?
  confidenceScore Int      @default(0)
  createdAt       DateTime @default(now())

  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([dateChecked])
  @@index([status])
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  author    String   @default("Anonymous")
  status    String   @default("APPROVED") // PENDING, APPROVED, SPAM, DELETED
  gameId    String?  // e.g. "shillong" to link to a specific game's live page
  date      String?  // e.g. "2026-05-02" to link to a specific date
  ipAddress String?  // basic spam prevention
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([gameId])
  @@index([date])
  @@index([createdAt])
}

model DreamNumber {
  id          String   @id @default(cuid())
  dream       String   @unique
  slug        String   @unique
  numbers     String
  
  // SEO Fields
  seoTitle    String?
  seoDesc     String?
  keywords    String?
  bodyText    String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}
