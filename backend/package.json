    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.2",
    "bullmq": "^5.73.4",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "ioredis": "^5.10.1",
    "node-cron": "^3.0.3",
    "playwright": "^1.59.1",
    "prisma": "^5.7.1",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
