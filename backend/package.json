{
  "name": "teer-backend",
  "version": "1.0.0",
  "description": "Backend service for scraping game results and admin management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.cjs watch src/index.ts",
    "dev:worker": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.cjs watch src/worker.ts",
    "build": "tsc",
    "start": "node --max-old-space-size=4096 dist/index.js",
    "start:worker": "node --max-old-space-size=4096 dist/worker.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "jest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
